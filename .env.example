# ------------------------------------------------------------
# Shared / global
# DEBUG_MODE=false  -> OFFICIAL profile
# DEBUG_MODE=true   -> TEST profile
# All values must be literal. Do not use inline comments or ${VAR}.
# ------------------------------------------------------------
DEBUG_MODE=false
NODE_ENV=production
DATABASE_URL=postgres://user:password@localhost:5432/major_bot
POLL_THRESHOLD_GAMES=10
WEBHOOK_PORT=3000
PUBLIC_WEBHOOK_PATH=/neatqueue-webhook
SMART_PING_MIN_PLAYERS=7
SMART_PING_COOLDOWN_SECONDS=300
NEATQUEUE_BOT_ID=857633321064595466
RESULTS_ALERT_USER_ID=1055925368055410759

# ------------------------------------------------------------
# OFFICIAL profile
# Main production server used when DEBUG_MODE=false
# ------------------------------------------------------------
